# Copy to .env locally. Populate only the providers you use.
# Credentials stay in the local StackQL process, not in Copilot prompts.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Include the session token when using temporary AWS credentials.
AWS_SESSION_TOKEN=

AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Single-quoted, complete Google service account JSON, not a file path.
# Preserve \n escapes inside the JSON private_key string.
GOOGLE_CREDENTIALS=
